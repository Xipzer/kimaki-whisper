{
  "name": "wendy",
  "version": "0.1.0",
  "description": "Wendy - local voice-first personal assistant: Discord VC presence, STT/LLM/TTS pipeline, and switchboard to a Kimaki agent organisation. Includes the whisper transcription sidecar.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "wendy": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --experimental-strip-types --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.16.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xipzer/kimaki-whisper.git"
  },
  "homepage": "https://github.com/Xipzer/kimaki-whisper#readme",
  "keywords": [
    "kimaki",
    "whisper",
    "transcription",
    "discord",
    "local",
    "voice"
  ]
}
